# 仕様書 4.3。このファイルをコピーして .env.local を作る。
# .env.local はコミットしない（.gitignore で除外済み）。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバ専用。NEXT_PUBLIC_ を絶対に付けない（仕様書 2.2-2 / 4.2）。
# Phase 2（AIレシピ生成）から使う。
ANTHROPIC_API_KEY=

# SERVICE ROLE KEY はここに置かない。
# RLS を迂回できるため、アプリコードでは使用しない（仕様書 2.2-3）。
