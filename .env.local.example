# 仕様書 4.3（変更記録 2 章で ANTHROPIC_API_KEY を削除）。
# このファイルをコピーして .env.local を作る。
# .env.local はコミットしない（.gitignore で除外済み）。
#
# 配信時は GitHub Secrets の同名の値がビルドに埋め込まれる。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE KEY はここに置かない。
# RLS を迂回できるため、アプリコードでは使用しない（仕様書 2.2-3）。
# マイグレーション用のスクリプトは supabase/README.md を参照。
